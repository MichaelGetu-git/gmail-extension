{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    { "source": "/(.*)", "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }] }
  ],
  "functions": {
    "api/tick.js": { "maxDuration": 60 },
    "api/admin.js": { "maxDuration": 60 }
  },
  "crons": [
    { "path": "/api/tick", "schedule": "0 6 * * 1-5" }
  ]
}
